<sdf version="1.7">
  <world name="default">
    <!-- A narrow corridor opens into empty space at x=1.6; no world truth
         is supplied to the controller. Spawn at (0,0) heading +X. -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.5 -4 5 0 0.9 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.75 0.82 0.9 1</background></scene>
    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static><link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="exit_corridor">
      <static>true</static>
      <link name="left_wall"><pose>0.425 0.325 0.15 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.35 0.05 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.35 0.05 0.30</size></box></geometry>
          <material><ambient>0.5 0.56 0.63 1</ambient><diffuse>0.68 0.74 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="right_wall"><pose>0.425 -0.325 0.15 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.35 0.05 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.35 0.05 0.30</size></box></geometry>
          <material><ambient>0.5 0.56 0.63 1</ambient><diffuse>0.68 0.74 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="back_wall"><pose>-0.775 0 0.15 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.05 0.70 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.70 0.30</size></box></geometry>
          <material><ambient>0.5 0.56 0.63 1</ambient><diffuse>0.68 0.74 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
